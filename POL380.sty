%% ======================================================================
%% POL380.sty 
%%
%%  Usage:
%%    \usepackage[proposal]{polecon}   % Research-proposal (default)
%%    \usepackage[paper]{polecon}      % Full-paper (same look & feel)
%% ======================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{POL380}[2026/10/19 Political economy proposal/paper style]

\makeatletter

% ===================== Options ===========================================
\newif\ifpe@paper \pe@paperfalse
\DeclareOption{proposal}{\pe@paperfalse}
\DeclareOption{paper}{\pe@papertrue}
\ExecuteOptions{proposal}
\ProcessOptions\relax 

\ifpe@paper
  \newcommand{\pe@doctype}{Working Paper} 
\else
  \newcommand{\pe@doctype}{POL380 Paper Proposal} %%%%% Sets label in top left corner of first page 
\fi

% ============== Fonts & Page Setup ========================================
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{mathpazo}                  % Palatino text + math
\RequirePackage[scaled=0.92]{helvet}       % sans for headings
\RequirePackage{microtype}
\RequirePackage[margin=1.2in, headheight=14pt, footskip=0.5in]{geometry}
\RequirePackage{setspace}
\ifpe@paper \setstretch{1.12}\else \setstretch{1.06}\fi


% ===================== Colors ==========================================
\RequirePackage[dvipsnames,table]{xcolor}
\definecolor{pe-navy}{HTML}{181714}
\definecolor{pe-accent}{HTML}{5A7370}
\definecolor{pe-light}{HTML}{F3F4F8}
\definecolor{pe-rule}{HTML}{B8BDCB}
\definecolor{pe-grey}{HTML}{5A7370}

% ==================== Set up lists, tables, figures, and captions =================
\RequirePackage{enumitem}
\setlist{nosep, leftmargin=*, itemsep=2pt, topsep=4pt}
\setlist[itemize]{label=\textcolor{pe-accent}{\textbullet}}
\setlist[enumerate]{label=\textcolor{pe-accent}{\bfseries\arabic*.}}

\RequirePackage{booktabs, array, tabularx, graphicx} 
\renewcommand{\arraystretch}{1.22}
\setlength{\heavyrulewidth}{0.9pt}
\setlength{\lightrulewidth}{0.5pt}

\RequirePackage[font=small, labelfont={sf,bf,color=pe-navy}, labelsep=period,
                textfont=it, format=hang, margin=8pt]{caption}

% small note beneath a table or figure
\newcommand{\tabnote}[1]{\par\vspace{3pt}{\footnotesize\color{pe-grey}\textit{Note:} #1}\par}

% ======================= Headings ======================================
\RequirePackage[explicit]{titlesec}
\titleformat{\section}
  {\sffamily\Large\bfseries\color{pe-navy}}
  {\thesection}{0.7em}{#1}
  [\vspace{-0.3em}{\color{pe-accent}\titlerule[0.9pt]}]
\titleformat{\subsection}
  {\sffamily\large\bfseries\color{pe-navy}}
  {\thesubsection}{0.7em}{#1}
\titleformat{\subsubsection}
  {\sffamily\normalsize\bfseries\itshape\color{pe-grey}}
  {\thesubsubsection}{0.6em}{#1}
\titlespacing*{\section}{0pt}{2.0ex plus 0.5ex minus 0.2ex}{1.2ex}
\titlespacing*{\subsection}{0pt}{1.8ex plus 0.4ex minus 0.2ex}{0.8ex}
\titlespacing*{\subsubsection}{0pt}{1.4ex plus 0.3ex minus 0.2ex}{0.6ex}

% ============================ Boxes for Abstract & Hypothesis ===============
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins, breakable}

\newtcolorbox{abstractbox}{%
  enhanced, breakable, frame hidden, colback=pe-light,
  borderline north={1.4pt}{0pt}{pe-navy},
  borderline south={0.5pt}{0pt}{pe-navy},
  left=10pt, right=10pt, top=8pt, bottom=8pt,
  before upper={\small\setstretch{1.05}}}

% Numbered, optionally labelled hypothesis boxes.
%   \begin{hypothesis}[Presidentialism] ... \end{hypothesis}
\newtcolorbox[auto counter]{hypothesis}[1][]{%
  enhanced, breakable, frame hidden, colback=pe-light,
  borderline west={2.8pt}{0pt}{pe-accent},
  left=12pt, right=10pt, top=6pt, bottom=6pt, before skip=8pt, after skip=8pt,
  before upper={\textsf{\bfseries\color{pe-accent}H\thetcbcounter%
    \ifx\relax#1\relax\else\ (#1)\fi.}\enspace}}

% ======================= Title Block ======================================
\newcommand{\papertitle}[1]{\gdef\pe@title{#1}}
\newcommand{\papersubtitle}[1]{\gdef\pe@subtitle{#1}}
\newcommand{\paperauthor}[1]{\gdef\pe@author{#1}}
\newcommand{\paperaffil}[1]{\gdef\pe@affil{#1}}
\newcommand{\paperemail}[1]{\gdef\pe@email{#1}}
\newcommand{\paperdate}[1]{\gdef\pe@date{#1}}

\gdef\pe@title{Title}\gdef\pe@subtitle{}\gdef\pe@shorttitle{}
\gdef\pe@author{Author}\gdef\pe@affil{}\gdef\pe@email{}
\gdef\pe@date{\today}\gdef\pe@keywords{}\gdef\pe@jel{}\gdef\pe@note{}

\newcommand{\pe@opt}[2]{\ifx#1\@empty\else#2\fi}

\renewcommand{\maketitle}{%
  \thispagestyle{pefirst}%
  \begingroup\setlength{\parindent}{0pt}\noindent
  {\color{pe-navy}\rule{\linewidth}{3pt}}\par\vspace{0.7em}
  {\sffamily\bfseries\small\color{pe-accent}\MakeUppercase{\pe@doctype}\hfill
   \normalfont\small\color{pe-grey}\pe@date}\par\vspace{1.0em}
  {\raggedright\sffamily\bfseries\fontsize{22}{27}\selectfont\color{pe-navy}\pe@title\par}
  \ifx\pe@subtitle\@empty\else
    \vspace{0.4em}
    {\raggedright\sffamily\large\color{pe-grey}\pe@subtitle\par}
  \fi
  \vspace{1.1em}
  {\sffamily\large\color{pe-navy}\pe@author\par}
  \ifx\pe@affil\@empty\else{\small\color{pe-grey}\pe@affil\par}\fi
  \ifx\pe@email\@empty\else{\small\ttfamily\color{pe-grey}\pe@email\par}\fi
  \vspace{0.7em}
  {\color{pe-rule}\rule{\linewidth}{0.5pt}}\par\vspace{0.9em}
  \endgroup
  \global\let\maketitle\relax}

% ====================== Headers & Footers ===========================
\RequirePackage{fancyhdr}
\renewcommand{\headrule}{{\color{pe-rule}\hrule width\headwidth height\headrulewidth}}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{pemain}{%
  \fancyhf{}%
  \fancyhead[L]{\sffamily\footnotesize\color{pe-navy}%
    \ifx\pe@shorttitle\@empty\pe@title\else\pe@shorttitle\fi}%
  \fancyhead[R]{\sffamily\footnotesize\color{pe-grey}\pe@doctype}%
  \fancyfoot[C]{\sffamily\footnotesize\color{pe-navy}\thepage}%
}
\fancypagestyle{pefirst}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\sffamily\footnotesize\color{pe-navy}\thepage}%
}
\pagestyle{pemain}

% ==================== Bibliography =================================
\RequirePackage[round, authoryear, sort]{natbib}
\setlength{\bibsep}{4pt}
\renewcommand{\bibsection}{\section*{References}}

\RequirePackage[colorlinks=true, linkcolor=pe-navy, citecolor=pe-accent,
                urlcolor=pe-accent, pdfborder={0 0 0}]{hyperref}

\setlength{\parindent}{1.4em}
\setlength{\parskip}{0pt}
\raggedbottom

\makeatother
\endinput